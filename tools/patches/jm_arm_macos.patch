# JM (H.264/AVC reference, JM-19.1) — ARM macOS / aarch64 compatibility patch
#
# Purpose: gate the global `-msse4.1` compile flag to x86/x86_64 only.
# Upstream JM unconditionally adds `-msse4.1` for any UNIX/MINGW host, which
# breaks compilation on Apple Silicon (arm64) and aarch64 Linux because
# clang/gcc on those targets don't accept the flag.
#
# Status: NOT auto-applied (kept as documentation/backup).
#   The modification has been committed directly to tools/JM-JM-19.1/
#   for convenience. This patch exists so that:
#     1. The change can be reviewed as a diff (instead of poking through source)
#     2. If the source tree is ever replaced (e.g. JM upgrade), the same
#        fix can be re-applied with: `git apply jm_arm_macos.patch`
#
# To re-apply against a pristine JM-19.1 source tree:
#   cd tools/JM-JM-19.1
#   git apply ../patches/jm_arm_macos.patch
#
# Verified against: JM-19.1 (from JM-JM-19.1.zip shipped 2025-09-30)

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -96,7 +96,9 @@
 bb_enable_warnings( msvc warnings-as-errors "/wd4996 /wd5105 /wd5103" )
 
 # enable sse4.1 build for all source files for gcc and clang
-if( UNIX OR MINGW )
+# (only on x86/x86_64 — ARM64 (Apple Silicon, aarch64 Linux) doesn't support
+#  the -msse4.1 flag; falls back to scalar / NEON paths there.)
+if( ( UNIX OR MINGW ) AND ( CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|i[3-6]86|AMD64)$" ) )
   add_compile_options( "-msse4.1" )
 endif()
 
