# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Project-level compiled binaries (project root bin/)
# Also catches tools/<encoder>/bin/ since pattern is unanchored.
bin/

# Build artifacts inside the encoder source trees under tools/.
# We DO track:
#   - tools/<encoder>/source/   (source code, including our CMakeLists.txt edits)
#   - tools/<encoder>/cfg/      (official CTC configs + JM HM-like configs)
#   - tools/<encoder>/cmake/    (CMake helper modules)
#   - tools/<encoder>/CMakeLists.txt, Makefile, README, etc.
# We DO NOT track these build-output directories:
tools/*/build/
tools/*/lib/
tools/*/bin/

# Defensive CMake / compiler junk (in case anything leaks out of build/)
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake

# Compiled object / archive / shared library / debug bundles
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.dSYM/
*.exe

# Xcode user-specific files (Xcode generator on macOS produces these)
xcuserdata/
*.xcuserdatad/
project.xcworkspace/xcuserdata/

# Encoded outputs and intermediate files (project-level).
# runs/ is excluded wholesale EXCEPT the head-frames diagnostic runs: their
# encoder logs and jobs.csv are small text (~216 KB total) and are the evidence
# behind the ECM findings in README / HANDOFF 6.10-6.11a, and the input that
# scripts/estimate_missing_frames.py needs to reproduce results/Campfire_*_recon_*.csv.
# Bitstreams (11 MB) stay out via the *.bin rule below; so do tmp_configs/,
# the older *_pilot runs, and stray *.out files.
runs/*
!runs/fastTop7_*/
runs/fastTop7_*/*
!runs/fastTop7_*/logs/
!runs/fastTop7_*/jobs.csv
runs/fastTop7_*/logs/*
!runs/fastTop7_*/logs/*.log
sequences/*.yuv
sequences/*.y4m
# Subsampled AI YUVs produced by scripts/extract_ai_subsample.py
# (covered by sequences/*.yuv above, but called out explicitly for clarity)
sequences/*_AI_TSR*.yuv
*.bin
*.264
*.265
*.266
*.h266
*.vvc

# Reconstructed YUV (large)
*_rec.yuv
*_rec_*.yuv

# JM (lencod) side-effect files written to CWD when run from the project root
# (sanity check, manual JM invocations). These are JM-specific artifacts.
data.txt
log.dat
stats.dat
leakybucketparam.cfg
leakybucketrate.cfg

# HM (TAppEncoder) side-effect: when --ReconFile is empty, HM still writes
# its default 'rec.yuv' into CWD. Same risk for manual VTM/ECM invocations.
rec.yuv

# OS junk
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.bak
*.orig
*~

# Log archives
*.log.gz
*.tar.gz

# Allow MANIFEST and small reference files
!sequences/MANIFEST.csv
!sequences/README.md

# Chinese MD and PDF files (Use for myself learning, not source)
*zh.*
